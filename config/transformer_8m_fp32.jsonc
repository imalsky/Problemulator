{
  // transformer_8m_fp32: ~8M-parameter full-scale transformer for the fair,
  // full-budget transformer-vs-LSTM comparison. fp32 throughout (NO AMP).
  //
  // Why this exists: the bf16 predecessor (transformer_8m_300ep) diverged --
  // it hit its best val at epoch 17, then destabilized to ~1e-2 and never
  // recovered (no NaN; it just bounced at ~untrained scale). Root cause was
  // bf16's low mantissa amplifying gradient spikes in the deep 6-layer stack,
  // with a near-flat high LR giving it no way back. The reported test 5.2e-5
  // was merely the epoch-17 checkpoint, not a converged model. Three
  // stability-oriented changes fix it, each keeping the comparison fair:
  //   1. fp32 (amp_autocast_dtype="none", use_amp=false) -- full dynamic range,
  //      the single change that removes the divergence root cause.
  //   2. QK-norm ON (use_qk_norm=true) -- normalizes attention logits, the
  //      dedicated stabilizer for deep attention stacks. Negligible param cost,
  //      transformer-internal so it does not affect apples-to-apples fairness.
  //   3. gradient_clip_val 2.0 -> 1.0 and warmup_epochs 10 -> 20 -- tighter
  //      clipping and a longer ramp damp early spikes (applied to BOTH models).
  //
  // Architecture: d_model=256, 6 encoder layers, FFN=2048 (8x), nhead=4,
  // dropout 0, GELU FFN. Depth (6 layers) is the lever that matters for RT
  // non-locality (6L decisively beat the 3L transformer_final). Every matrix
  // dimension is a power of 2 (d_model=256, dim_feedforward=2048, nhead=4,
  // batch_size=512); only num_layers=6 is a plain round layer count.
  //
  // Parameter match (verified by instantiating create_prediction_model):
  //   transformer_8m_fp32: 7,967,234 params  (QK-norm adds +1,536 over the
  //                        7,965,698 of the bf16 variant -- +0.02%, negligible)
  //   lstm_8m_fp32:        7,993,794 params  (+0.33%)
  //
  // Training: fp32, batch 512, lr 1e-4, warmup 20, cosine to 300 epochs,
  // grad-clip 1.0, early-stop patience 60, EMA on (decay 0.999). lstm_8m_fp32
  // uses an IDENTICAL training + precision block (fp32, clip 1.0, warmup 20),
  // sharing data/splits/normalization cache/seed; only the architecture differs.
  "miscellaneous_settings": {
    "random_seed": 42,
    "num_workers": 16,
    "detect_anomaly": false,
    "shard_size": 10000,
    "hdf5_read_chunk_size": 8192,
    "device_backend": "cuda",
    "torch_compile": false,
    "compile_mode": "default",
    "execution_mode": "train",
    "rebuild_processed_data": false,
    "dataset_loading_mode": "auto",
    "dataset_max_cached_shards": 200,
    "dataset_large_shard_mmap_bytes": 52428800,
    "dataset_ram_safety_fraction": 0.8,
    "dataset_copy_mmap_slices": true
  },
  "data_paths_config": {
    "hdf5_dataset_filename": [
      "picaso_results_5M.h5"
    ],
    "dataset_splits_filename": "dataset_splits.json",
    "dataset_split_fractions": {
      "train": 0.7,
      "validation": 0.15,
      "test": 0.15
    }
  },
  "data_specification": {
    "input_variables": [
      "pressure_bar",
      "temperature_k"
    ],
    "global_variables": [
      "orbital_distance_m"
    ],
    "target_variables": [
      "net_thermal_flux",
      "net_reflected_flux"
    ],
    "strictly_positive_variables": [
      "pressure_bar",
      "temperature_k",
      "orbital_distance_m"
    ],
    "variable_units": {
      "pressure_bar": "bar",
      "temperature_k": "K",
      "orbital_distance_m": "m",
      "net_thermal_flux": "erg cm^-2 s^-1",
      "net_reflected_flux": "erg cm^-2 s^-1"
    },
    "padding_value": -9999.0
  },
  "normalization": {
    "key_methods": {
      "pressure_bar": "log-min-max",
      "temperature_k": "standard",
      "orbital_distance_m": "log-standard",
      "net_thermal_flux": "symlog",
      "net_reflected_flux": "symlog"
    },
    "epsilon": 1e-9,
    "padding_comparison_epsilon": 1e-6,
    "normalized_value_clamp": 50.0,
    "log_min_max_clamp_min": 0.0,
    "log_min_max_clamp_max": 1.0,
    "symlog_min_threshold_multiplier": 100.0,
    "stats_max_block_bytes": 536870912,
    "stats_max_span_multiplier": 16,
    "stats_chunk_size": 4096,
    "quantile_max_values_in_memory": 100000,
    "symlog_percentile": 0.01
  },
  "precision": {
    "input_dtype": "float32",
    "stats_accumulation_dtype": "float32",
    "model_dtype": "float32",
    "forward_dtype": "float32",
    "loss_dtype": "float32",
    "optimizer_state_dtype": "float32",
    "amp_autocast_dtype": "none",
    "float32_matmul_precision": "high"
  },
  "model_hyperparameters": {
    "model_type": "transformer",
    "d_model": 256,
    "dropout": 0.0,
    "film_clamp": 1000.0,
    "max_sequence_length": 75,
    "output_head_divisor": 1,
    "output_head_dropout_factor": 0.0,
    "head_activation": "gelu",
    "transformer": {
      "nhead": 4,
      "num_layers": 6,
      "dim_feedforward": 2048,
      "attention_dropout": 0.0,
      "use_qk_norm": true,
      "qkv_bias": true,
      "ffn_type": "gelu"
    },
    "lstm": {
      "num_layers": 2,
      "bidirectional": true
    }
  },
  "training_hyperparameters": {
    "epochs": 300,
    "batch_size": 512,
    "learning_rate": 0.0001,
    "weight_decay": 1e-5,
    "optimizer": "adamw",
    "adam_beta1": 0.9,
    "adam_beta2": 0.999,
    "gradient_clip_val": 1.0,
    "scheduler_type": "cosine",
    "min_lr": 1e-08,
    "warmup_epochs": 20,
    "warmup_start_factor": 0.1,
    "warmup_unit": "step",
    "plateau_patience": 10,
    "plateau_factor": 0.5,
    "plateau_threshold": 1e-05,
    "plateau_threshold_mode": "abs",
    "early_stopping_patience": 60,
    "min_delta": 1e-10,
    "use_amp": false,
    "ema_decay": 0.999,
    "dataset_fraction_to_use": 1.0
  },
  "loss": {
    "type": "signed_log_adaptive",
    "lambda_z": 1.0,
    "lambda_phys": 0.0,
    "fractional_epsilon": 1.0,
    "p_norm": 1,
    "weight_mode": "uniform",
    "weight_power": 0.0,
    "w_min": 1.0,
    "w_max": 1.0
  },
  "output_paths_config": {
    "fixed_model_foldername": "transformer_8m_fp32"
  }
}
