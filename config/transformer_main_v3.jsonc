{
  // Production config for transformer_main, reverted to paper-comparable
  // normalization/regularization after the May-2026 signed-log run regressed
  // on low-magnitude flux predictions.
  //
  // Architecture: d_model=512, num_layers=3, ffn_mult=4 -> dim_feedforward=2048,
  // attention_dropout=0, output_head_divisor=2, film_clamp=1000, dropout=0.
  // Resulting trainable parameter count: ~9.73M (exact match to lstm_main_v3
  // for apples-to-apples comparison; stays under the user's 10M cap).
  //
  // Reverts from the previous transformer_main_v3 (26.4M, signed-log):
  //   - net_thermal_flux / net_reflected_flux normalization: signed-log -> symlog
  //     (signed-log compresses |x|<<1 indistinguishably from zero, washing out
  //     the low-flux tail; symlog with threshold from the 0.01-percentile keeps
  //     small values in a linear regime; this matches the SAFE_PAPER_VERSION).
  //   - film_clamp: 50.0 -> 1000.0 (paper value; the May-2026 sweep best-trial
  //     used 50 but the paper used 1000, which permits stronger global-feature
  //     modulation across orbital-distance regimes).
  //   - weight_decay: 0.05 -> 1e-5 (paper value; 0.05 is 5000x stronger than
  //     the paper and over-regularized the low-flux tail).
  //   - early_stopping_patience: 30 -> 100 (paper used 99999, effectively no
  //     early stop; 100 still allows ~1/3 of the 300-epoch budget for the model
  //     to escape transient plateaus).
  //   - dim_feedforward: 4096 -> 2048; num_layers stays at 3 (was 5) so total
  //     model size drops 26.4M -> 9.73M, matching lstm_main_v3 exactly for a
  //     clean LSTM/Transformer comparison under the ~10M cap.
  //
  // The loss is pure z-MSE (signed_log_adaptive with lambda_phys=0).
  "miscellaneous_settings": {
    "random_seed": 42,
    "num_workers": 1,
    "detect_anomaly": false,
    "shard_size": 10000,
    "hdf5_read_chunk_size": 8192,
    // Available backends: "cuda", "mps", "cpu"
    "device_backend": "cuda",
    "torch_compile": false,
    // Available compile modes: "default", "reduce-overhead",
    // "max-autotune", "max-autotune-no-cudagraphs"
    "compile_mode": "default",
    // Available modes: "normalize", "train"
    "execution_mode": "train",
    "rebuild_processed_data": false,
    // Available dataset loading modes: "auto", "ram", "disk"
    "dataset_loading_mode": "auto",
    "dataset_max_cached_shards": 200,
    "dataset_large_shard_mmap_bytes": 52428800,
    "dataset_ram_safety_fraction": 0.8,
    "dataset_copy_mmap_slices": true
  },
  "data_paths_config": {
    "hdf5_dataset_filename": [
      "picaso_results_5M.h5"
    ],
    "dataset_splits_filename": "dataset_splits.json",
    "dataset_split_fractions": {
      "train": 0.7,
      "validation": 0.15,
      "test": 0.15
    }
  },
  "data_specification": {
    "input_variables": [
      "pressure_bar",
      "temperature_k"
    ],
    "global_variables": [
      "orbital_distance_m"
    ],
    "target_variables": [
      "net_thermal_flux",
      "net_reflected_flux"
    ],
    "strictly_positive_variables": [
      "pressure_bar",
      "temperature_k",
      "orbital_distance_m"
    ],
    "variable_units": {
      "pressure_bar": "bar",
      "temperature_k": "K",
      "orbital_distance_m": "m",
      "net_thermal_flux": "erg cm^-2 s^-1",
      "net_reflected_flux": "erg cm^-2 s^-1"
    },
    "padding_value": -9999.0
  },
  "normalization": {
    "key_methods": {
      "pressure_bar": "log-min-max",
      "temperature_k": "standard",
      "orbital_distance_m": "log-standard",
      // symlog on the flux channels (paper convention). signed-log was tried
      // in the May-2026 sweep but compresses small |x| values indistinguishably
      // from zero, washing out the low-flux tail in predictions.
      "net_thermal_flux": "symlog",
      "net_reflected_flux": "symlog"
    },
    "epsilon": 1e-9,
    "padding_comparison_epsilon": 1e-6,
    "normalized_value_clamp": 50.0,
    "log_min_max_clamp_min": 0.0,
    "log_min_max_clamp_max": 1.0,
    "symlog_min_threshold_multiplier": 100.0,
    "stats_max_block_bytes": 536870912,
    "stats_max_span_multiplier": 16,
    "stats_chunk_size": 4096,
    "quantile_max_values_in_memory": 100000,
    "symlog_percentile": 0.01
  },
  "precision": {
    "input_dtype": "float32",
    "stats_accumulation_dtype": "float32",
    "model_dtype": "float32",
    "forward_dtype": "float32",
    "loss_dtype": "float32",
    "optimizer_state_dtype": "float32",
    "amp_autocast_dtype": "bfloat16",
    "float32_matmul_precision": "high"
  },
  "model_hyperparameters": {
    // Compact reference point under the symlog flux normalization, sized to
    // match lstm_main_v3 at 9.73M params exactly (d_model=512, num_layers=3,
    // ffn_mult=4 -> dim_feedforward=2048). All other knobs match trial 20:
    // attention_dropout=0, dropout=0, output_head_divisor=2.
    "model_type": "transformer",
    "d_model": 512,
    "dropout": 0.0,
    "film_clamp": 1000.0,
    "max_sequence_length": 75,
    "output_head_divisor": 2,
    "output_head_dropout_factor": 0.0,
    // Activation in the 2-linear output projection head. Tuned in the
    // 64-trial sweep (gelu vs silu); paper default is "gelu".
    "head_activation": "gelu",
    "transformer": {
      "nhead": 4,
      "num_layers": 3,
      "dim_feedforward": 2048,
      "attention_dropout": 0.0,
      // QK-Norm (Henry et al. 2020): per-head LayerNorm on Q and K before SDPA.
      "use_qk_norm": true,
      // Bias on Q/K/V/out projections; modern practice keeps these on for
      // small models. Set false to drop them.
      "qkv_bias": true,
      // FFN variant: "gelu" = Linear-GELU-Linear (original),
      // "swiglu" = LLaMA/PaLM-style gated FFN. Tuner fixed this to "gelu".
      "ffn_type": "gelu"
    },
    "lstm": {
      "num_layers": 3,
      "bidirectional": true
    }
  },
  "training_hyperparameters": {
    "epochs": 300,
    "batch_size": 256,
    "learning_rate": 0.0001,
    "weight_decay": 1e-5,
    "optimizer": "adamw",
    // AdamW betas: (0.9, 0.95) is the GPT-3/LLaMA/PaLM convention for
    // transformers and adapts faster than the PyTorch default (0.9, 0.999).
    "adam_beta1": 0.9,
    "adam_beta2": 0.95,
    "gradient_clip_val": 2.0,
    // Available schedulers: "cosine", "plateau"
    "scheduler_type": "cosine",
    "min_lr": 1e-08,
    "warmup_epochs": 10,
    "warmup_start_factor": 0.1,
    // Warmup granularity: "epoch" (legacy, one LR step per epoch) or "step"
    // (per optimizer step — smoother, modern default).
    "warmup_unit": "step",
    "plateau_patience": 10,
    "plateau_factor": 0.5,
    "plateau_threshold": 1e-05,
    // Available threshold modes: "abs", "rel"
    "plateau_threshold_mode": "abs",
    "early_stopping_patience": 100,
    "min_delta": 1e-05,
    "use_amp": true,
    // Polyak averaging (EMA) of model weights. ``0`` disables; ``0.999`` is
    // the canonical default for vision/regression checkpoints.
    "ema_decay": 0.999,
    "dataset_fraction_to_use": 1.0
  },
  "loss": {
    // Pure MSE in normalized space (matches tune_rt_tune_20260512_181651).
    //       L = masked_mean((pred_z - true_z)^2)
    // Implemented inside signed_log_adaptive by setting lambda_phys=0 so the
    // physical fractional-L1 term is dropped entirely. If lambda_phys > 0:
    //       L_phys = abs(pred_phys - true_phys) / sqrt(true_phys^2 + epsilon)
    "type": "signed_log_adaptive",
    "lambda_z": 1.0,
    "lambda_phys": 0.0,
    // Denominator floor in target-physical units squared (erg cm^-2 s^-1)^2.
    "fractional_epsilon": 1.0,
    // p_norm is retained as a compatibility guard; only L1 (1) is supported.
    "p_norm": 1,
    // Legacy weight fields are ignored by the current fractional-L1 loss.
    "weight_mode": "uniform",
    "weight_power": 0.0,
    "w_min": 1.0,
    "w_max": 1.0
  },
  "output_paths_config": {
    "fixed_model_foldername": "transformer_main"
  }
}
