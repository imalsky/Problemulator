    "        )\n",
    "\n",
    "        color = PROFILE_LINE_COLORS[k % len(PROFILE_LINE_COLORS)]\n",
    "\n",
    "        if thermal_idx is not None:\n",
    "            yt_t, yt_p = t[:, thermal_idx], p[:, thermal_idx]\n",
    "\n",
    "            # Plot all thermal flux values; visible range is controlled only by THERMAL_XLIM.\n",
    "            ax_t.plot(\n",
    "                yt_t,\n",
    "                pr_vals,\n",
    "                color=color,\n",
    "                alpha=0.4,\n",
    "                linewidth=4,\n",
    "            )\n",
    "            ax_t.plot(\n",
