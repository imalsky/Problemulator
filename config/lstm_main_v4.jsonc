{
  // v4 — LSTM baseline alongside transformer_main_v4. Same goal: eliminate
  // the low-pressure signed-mean bias documented in
  // Paper_Work/audit_2026-05-08.md:43. Strategy mirrors transformer_main_v4 —
  // disable every "modernization" present in v3 but ABSENT from
  // Problemulator_SAFE_PAPER_VERSION/config/config.jsonc that could plausibly
  // bias low-magnitude predictions.
  //
  // Disabled vs v3:
  //   - use_amp: true -> false. bfloat16 autocast has ~7-bit mantissa; low-
  //     magnitude activations/gradients quantize non-uniformly. Paper was
  //     pure float32.
  //   - ema_decay: 0.999 -> 0. train.py:1122-1126 saves EMA weights as
  //     best_model.pt and inference IS EMA. Paper had no EMA.
  //   - film_clamp: 1000.0 -> 10.0. Paper value
  //     (SAFE_PAPER_VERSION/config/config.jsonc:70). The v3 file's comment
  //     claimed 1000 was "the paper value" but it was actually 10.
  //   - output_head_dropout_factor: 0.25 -> 0.0. Not in the paper config.
  //     With dropout=0 this may already be a no-op; zeroing is conservative.
  //   - adam_beta2: 0.95 -> 0.999. Paper used PyTorch defaults.
  //   - early_stopping_patience: 100 -> 30. Tighter than v3 to keep total
  //     SLURM cost bounded; matches transformer_main_v4.
  //
  // Preserved from v3 (matched to transformer_main_v4 at ~10M params):
  //   - d_model=512, num_layers=2 bidirectional. ~9.73M trainable.
  //   - symlog flux normalization, percentile 0.01.
  //   - weight_decay=1e-5, lr=1e-4, batch_size=256.
  //
  // Training schedule and loss are identical to transformer_main_v4 for an
  // apples-to-apples comparison.
  "miscellaneous_settings": {
    "random_seed": 42,
    "num_workers": 1,
    "detect_anomaly": false,
    "shard_size": 10000,
    "hdf5_read_chunk_size": 8192,
    "device_backend": "cuda",
    "torch_compile": false,
    "compile_mode": "default",
    "execution_mode": "train",
    "rebuild_processed_data": false,
    "dataset_loading_mode": "auto",
    "dataset_max_cached_shards": 200,
    "dataset_large_shard_mmap_bytes": 52428800,
    "dataset_ram_safety_fraction": 0.8,
    "dataset_copy_mmap_slices": true
  },
  "data_paths_config": {
    "hdf5_dataset_filename": [
      "picaso_results_5M.h5"
    ],
    "dataset_splits_filename": "dataset_splits.json",
    "dataset_split_fractions": {
      "train": 0.7,
      "validation": 0.15,
      "test": 0.15
    }
  },
  "data_specification": {
    "input_variables": [
      "pressure_bar",
      "temperature_k"
    ],
    "global_variables": [
      "orbital_distance_m"
    ],
    "target_variables": [
      "net_thermal_flux",
      "net_reflected_flux"
    ],
    "strictly_positive_variables": [
      "pressure_bar",
      "temperature_k",
      "orbital_distance_m"
    ],
    "variable_units": {
      "pressure_bar": "bar",
      "temperature_k": "K",
      "orbital_distance_m": "m",
      "net_thermal_flux": "erg cm^-2 s^-1",
      "net_reflected_flux": "erg cm^-2 s^-1"
    },
    "padding_value": -9999.0
  },
  "normalization": {
    "key_methods": {
      "pressure_bar": "log-min-max",
      "temperature_k": "standard",
      "orbital_distance_m": "log-standard",
      "net_thermal_flux": "symlog",
      "net_reflected_flux": "symlog"
    },
    "epsilon": 1e-9,
    "padding_comparison_epsilon": 1e-6,
    "normalized_value_clamp": 50.0,
    "log_min_max_clamp_min": 0.0,
    "log_min_max_clamp_max": 1.0,
    "symlog_min_threshold_multiplier": 100.0,
    "stats_max_block_bytes": 536870912,
    "stats_max_span_multiplier": 16,
    "stats_chunk_size": 4096,
    "quantile_max_values_in_memory": 100000,
    "symlog_percentile": 0.01
  },
  "precision": {
    "input_dtype": "float32",
    "stats_accumulation_dtype": "float32",
    "model_dtype": "float32",
    "forward_dtype": "float32",
    "loss_dtype": "float32",
    "optimizer_state_dtype": "float32",
    // Inert when use_amp=false but kept for schema compatibility.
    "amp_autocast_dtype": "bfloat16",
    "float32_matmul_precision": "high"
  },
  "model_hyperparameters": {
    "model_type": "lstm",
    "d_model": 512,
    "dropout": 0.0,
    // Paper value (SAFE_PAPER_VERSION/config/config.jsonc:70). v3 used 1000.
    "film_clamp": 10.0,
    "max_sequence_length": 75,
    "output_head_divisor": 1,
    // Zeroed vs v3 (was 0.25). Not in the paper config; conservative revert.
    "output_head_dropout_factor": 0.0,
    // Activation in the 2-linear output projection head. Paper default "gelu".
    "head_activation": "gelu",
    // Transformer block is unused for model_type=lstm but required by the
    // schema; values are placeholders.
    "transformer": {
      "nhead": 4,
      "num_layers": 4,
      "dim_feedforward": 1024,
      "attention_dropout": 0.0,
      "use_qk_norm": false,
      "qkv_bias": true,
      "ffn_type": "gelu"
    },
    "lstm": {
      "num_layers": 2,
      "bidirectional": true
    }
  },
  "training_hyperparameters": {
    "epochs": 300,
    "batch_size": 256,
    "learning_rate": 0.0001,
    "weight_decay": 1e-5,
    "optimizer": "adamw",
    // PyTorch defaults (paper). v3 used 0.95 (LLaMA convention).
    "adam_beta1": 0.9,
    "adam_beta2": 0.999,
    "gradient_clip_val": 2.0,
    "scheduler_type": "cosine",
    "min_lr": 1e-08,
    "warmup_epochs": 10,
    "warmup_start_factor": 0.1,
    "warmup_unit": "step",
    "plateau_patience": 10,
    "plateau_factor": 0.5,
    "plateau_threshold": 1e-05,
    "plateau_threshold_mode": "abs",
    "early_stopping_patience": 30,
    "min_delta": 1e-05,
    // Disabled vs v3 to avoid bfloat16 weight-quantization bias at low fluxes.
    "use_amp": false,
    // Disabled vs v3. EMA weights are loaded at inference (train.py:1122-1126).
    "ema_decay": 0,
    "dataset_fraction_to_use": 1.0
  },
  "loss": {
    "type": "signed_log_adaptive",
    "lambda_z": 1.0,
    "lambda_phys": 0.0,
    "fractional_epsilon": 1.0,
    "p_norm": 1,
    "weight_mode": "uniform",
    "weight_power": 0.0,
    "w_min": 1.0,
    "w_max": 1.0
  },
  "output_paths_config": {
    "fixed_model_foldername": "lstm_main"
  }
}
