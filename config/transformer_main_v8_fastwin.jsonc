{
  // v8 fast-win run: transformer side of a 2M-profile matched head-to-head.
  // This keeps the v7-style full LSTM/transformer comparison, but moves the
  // transformer to the strongest sweep-supported depth/width family instead
  // of the older 8M GELU stack.
  //
  // Evidence:
  //   - The 20%-data sweep's best transformer was trial 59:
  //     5,307,010 params, d_model=256, 5 layers, FFN=1024, SwiGLU,
  //     QK-norm on, val_loss=3.125e-05. This config switches the FFN to
  //     GELU and widens it to 1536 to retain the same parameter scale.
  //   - The paired LSTM uses a reasonable 2-layer bidirectional architecture
  //     at d_model=376 for 5,253,474 params, matching this 5,337,602-param
  //     transformer within 1.6% while
  //     avoiding the 8M LSTM regime that already beat the old transformer.
  //
  // This run uses 0.40 of the 5M dataset: 2.0M profiles total
  // (1.4M train / 300k validation / 300k test). AMP uses bfloat16 autocast
  // only; weights, targets, optimizer state, and loss reduction remain
  // float32. EMA is enabled because the sweep frontier used it and it smooths
  // checkpoint selection in the 2M-profile regime. early_stopping_patience is
  // set to the full epoch count so both models run all 300 epochs.
  "miscellaneous_settings": {
    "random_seed": 42,
    "num_workers": 1,
    "detect_anomaly": false,
    "shard_size": 10000,
    "hdf5_read_chunk_size": 8192,
    "device_backend": "cuda",
    "torch_compile": false,
    "compile_mode": "default",
    "execution_mode": "train",
    "rebuild_processed_data": false,
    "dataset_loading_mode": "auto",
    "dataset_max_cached_shards": 200,
    "dataset_large_shard_mmap_bytes": 52428800,
    "dataset_ram_safety_fraction": 0.8,
    "dataset_copy_mmap_slices": true
  },
  "data_paths_config": {
    "hdf5_dataset_filename": [
      "picaso_results_5M.h5"
    ],
    "dataset_splits_filename": "dataset_splits.json",
    "dataset_split_fractions": {
      "train": 0.7,
      "validation": 0.15,
      "test": 0.15
    }
  },
  "data_specification": {
    "input_variables": [
      "pressure_bar",
      "temperature_k"
    ],
    "global_variables": [
      "orbital_distance_m"
    ],
    "target_variables": [
      "net_thermal_flux",
      "net_reflected_flux"
    ],
    "strictly_positive_variables": [
      "pressure_bar",
      "temperature_k",
      "orbital_distance_m"
    ],
    "variable_units": {
      "pressure_bar": "bar",
      "temperature_k": "K",
      "orbital_distance_m": "m",
      "net_thermal_flux": "erg cm^-2 s^-1",
      "net_reflected_flux": "erg cm^-2 s^-1"
    },
    "padding_value": -9999.0
  },
  "normalization": {
    "key_methods": {
      "pressure_bar": "log-min-max",
      "temperature_k": "standard",
      "orbital_distance_m": "log-standard",
      "net_thermal_flux": "symlog",
      "net_reflected_flux": "symlog"
    },
    "epsilon": 1e-9,
    "padding_comparison_epsilon": 1e-6,
    "normalized_value_clamp": 50.0,
    "log_min_max_clamp_min": 0.0,
    "log_min_max_clamp_max": 1.0,
    "symlog_min_threshold_multiplier": 100.0,
    "stats_max_block_bytes": 536870912,
    "stats_max_span_multiplier": 16,
    "stats_chunk_size": 4096,
    "quantile_max_values_in_memory": 100000,
    "symlog_percentile": 0.01
  },
  "precision": {
    "input_dtype": "float32",
    "stats_accumulation_dtype": "float32",
    "model_dtype": "float32",
    "forward_dtype": "float32",
    "loss_dtype": "float32",
    "optimizer_state_dtype": "float32",
    "amp_autocast_dtype": "bfloat16",
    "float32_matmul_precision": "high"
  },
  "model_hyperparameters": {
    "model_type": "transformer",
    "d_model": 256,
    "dropout": 0.0,
    "film_clamp": 1000.0,
    "max_sequence_length": 75,
    "output_head_divisor": 1,
    "output_head_dropout_factor": 0.0,
    "head_activation": "gelu",
    "transformer": {
      "nhead": 4,
      "num_layers": 5,
      "dim_feedforward": 1536,
      "attention_dropout": 0.0,
      "use_qk_norm": true,
      "qkv_bias": true,
      "ffn_type": "gelu"
    },
    "lstm": {
      "num_layers": 2,
      "bidirectional": true
    }
  },
  "training_hyperparameters": {
    "epochs": 300,
    "batch_size": 256,
    "learning_rate": 0.0001,
    "weight_decay": 1e-5,
    "optimizer": "adamw",
    "adam_beta1": 0.9,
    "adam_beta2": 0.95,
    "gradient_clip_val": 2.0,
    "scheduler_type": "cosine",
    "min_lr": 1e-08,
    "warmup_epochs": 2,
    "warmup_start_factor": 0.1,
    "warmup_unit": "step",
    "plateau_patience": 10,
    "plateau_factor": 0.5,
    "plateau_threshold": 1e-05,
    "plateau_threshold_mode": "abs",
    "early_stopping_patience": 300,
    "min_delta": 1e-10,
    "use_amp": true,
    "ema_decay": 0.999,
    "dataset_fraction_to_use": 0.40
  },
  "loss": {
    "type": "signed_log_adaptive",
    "lambda_z": 1.0,
    "lambda_phys": 0.0,
    "fractional_epsilon": 1.0,
    "p_norm": 1,
    "weight_mode": "uniform",
    "weight_power": 0.0,
    "w_min": 1.0,
    "w_max": 1.0
  },
  "output_paths_config": {
    "fixed_model_foldername": "transformer_main_v8_fastwin"
  }
}
