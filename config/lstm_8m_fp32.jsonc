{
  // lstm_8m_fp32: ~8M-parameter full-scale LSTM baseline for the fair,
  // full-budget transformer-vs-LSTM comparison. Matched-parameter (~8M)
  // recurrent baseline against transformer_8m_fp32, using the proven full-data
  // LSTM family (2 bidirectional blocks, zero dropout, FiLM globals, signed-log
  // loss). fp32 throughout (NO AMP).
  //
  // Parameter match (verified by instantiating create_prediction_model):
  //   lstm_8m_fp32:        7,993,794 params  (d_model=464, 2x BiLSTM)
  //   transformer_8m_fp32: 7,967,234 params  (-0.33%)
  //
  // Note on d_model=464: a 2-layer bidirectional LSTM has NO power-of-2 hidden
  // width at ~8M (256 -> 4.8M, 512 -> 9.7M), so the hidden size is the slack
  // variable used to tightly match the transformer's ~8M budget. Every other
  // architectural dimension is a power of 2 (lstm num_layers=2, batch_size=512).
  //
  // Training: IDENTICAL block to transformer_8m_fp32 -- fp32 (use_amp=false),
  // batch 512, lr 1e-4, warmup 20, cosine to 300 epochs, grad-clip 1.0,
  // early-stop patience 60, EMA 0.999. Both models share the same data, splits,
  // normalization cache, seed, and precision, so the comparison is
  // apples-to-apples; only the architecture differs. (QK-norm is a
  // transformer-internal stabilizer and has no analogue here.)
  "miscellaneous_settings": {
    "random_seed": 42,
    "num_workers": 16,
    "detect_anomaly": false,
    "shard_size": 10000,
    "hdf5_read_chunk_size": 8192,
    "device_backend": "cuda",
    "torch_compile": false,
    "compile_mode": "default",
    "execution_mode": "train",
    "rebuild_processed_data": false,
    "dataset_loading_mode": "auto",
    "dataset_max_cached_shards": 200,
    "dataset_large_shard_mmap_bytes": 52428800,
    "dataset_ram_safety_fraction": 0.8,
    "dataset_copy_mmap_slices": true
  },
  "data_paths_config": {
    "hdf5_dataset_filename": [
      "picaso_results_5M.h5"
    ],
    "dataset_splits_filename": "dataset_splits.json",
    "dataset_split_fractions": {
      "train": 0.7,
      "validation": 0.15,
      "test": 0.15
    }
  },
  "data_specification": {
    "input_variables": [
      "pressure_bar",
      "temperature_k"
    ],
    "global_variables": [
      "orbital_distance_m"
    ],
    "target_variables": [
      "net_thermal_flux",
      "net_reflected_flux"
    ],
    "strictly_positive_variables": [
      "pressure_bar",
      "temperature_k",
      "orbital_distance_m"
    ],
    "variable_units": {
      "pressure_bar": "bar",
      "temperature_k": "K",
      "orbital_distance_m": "m",
      "net_thermal_flux": "erg cm^-2 s^-1",
      "net_reflected_flux": "erg cm^-2 s^-1"
    },
    "padding_value": -9999.0
  },
  "normalization": {
    "key_methods": {
      "pressure_bar": "log-min-max",
      "temperature_k": "standard",
      "orbital_distance_m": "log-standard",
      "net_thermal_flux": "symlog",
      "net_reflected_flux": "symlog"
    },
    "epsilon": 1e-9,
    "padding_comparison_epsilon": 1e-6,
    "normalized_value_clamp": 50.0,
    "log_min_max_clamp_min": 0.0,
    "log_min_max_clamp_max": 1.0,
    "symlog_min_threshold_multiplier": 100.0,
    "stats_max_block_bytes": 536870912,
    "stats_max_span_multiplier": 16,
    "stats_chunk_size": 4096,
    "quantile_max_values_in_memory": 100000,
    "symlog_percentile": 0.01
  },
  "precision": {
    "input_dtype": "float32",
    "stats_accumulation_dtype": "float32",
    "model_dtype": "float32",
    "forward_dtype": "float32",
    "loss_dtype": "float32",
    "optimizer_state_dtype": "float32",
    "amp_autocast_dtype": "none",
    "float32_matmul_precision": "high"
  },
  "model_hyperparameters": {
    "model_type": "lstm",
    "d_model": 464,
    "dropout": 0.0,
    "film_clamp": 1000.0,
    "max_sequence_length": 75,
    "output_head_divisor": 1,
    "output_head_dropout_factor": 0.0,
    "head_activation": "gelu",
    "transformer": {
      "nhead": 4,
      "num_layers": 5,
      "dim_feedforward": 1024,
      "attention_dropout": 0.0,
      "use_qk_norm": true,
      "qkv_bias": true,
      "ffn_type": "swiglu"
    },
    "lstm": {
      "num_layers": 2,
      "bidirectional": true
    }
  },
  "training_hyperparameters": {
    "epochs": 300,
    "batch_size": 512,
    "learning_rate": 0.0001,
    "weight_decay": 1e-5,
    "optimizer": "adamw",
    "adam_beta1": 0.9,
    "adam_beta2": 0.999,
    "gradient_clip_val": 1.0,
    "scheduler_type": "cosine",
    "min_lr": 1e-08,
    "warmup_epochs": 20,
    "warmup_start_factor": 0.1,
    "warmup_unit": "step",
    "plateau_patience": 10,
    "plateau_factor": 0.5,
    "plateau_threshold": 1e-05,
    "plateau_threshold_mode": "abs",
    "early_stopping_patience": 60,
    "min_delta": 1e-10,
    "use_amp": false,
    "ema_decay": 0.999,
    "dataset_fraction_to_use": 1.0
  },
  "loss": {
    "type": "signed_log_adaptive",
    "lambda_z": 1.0,
    "lambda_phys": 0.0,
    "fractional_epsilon": 1.0,
    "p_norm": 1,
    "weight_mode": "uniform",
    "weight_power": 0.0,
    "w_min": 1.0,
    "w_max": 1.0
  },
  "output_paths_config": {
    "fixed_model_foldername": "lstm_8m_fp32"
  }
}
