{
  // transformer_win_candidate: transformer-favorable 2M-profile run.
  //
  // Goal: give the transformer its strongest empirically supported chance
  // without changing variables, targets, normalization, loss, or preprocessing.
  // This is intentionally not the same regime as transformer_final/lstm_final:
  // the full-5M, ~10M-parameter, long-schedule comparison currently favors the
  // LSTM. This config targets the regime where the transformer has actually
  // won so far: smaller parameter count, smaller data fraction, QK-norm, wider
  // output head, zero dropout, EMA, and the sweep-proven optimizer scale.
  //
  // Architecture source:
  //   tune_rt_tune_20260521_084622 trial 59 was the best 64-trial sweep result,
  //   but the sweep fixed output_head_divisor=2 and did not isolate that choice.
  //   The follow-up v8 fast-win config therefore kept the trial-59 shape
  //   family (d_model=256, 5 layers, QK-norm, dropout=0), restored the wider
  //   output head (output_head_divisor=1), and used GELU/1536 at a similar
  //   parameter scale. This config follows that later interpretation rather
  //   than copying trial 59 verbatim.
  //
  // Data/training choice:
  //   dataset_fraction_to_use=0.40 uses about 2.0M profiles total from the
  //   existing 5M split: 1.4M train / 300k validation / 300k test. That keeps
  //   the run transformer-favorable while giving it twice the data used by the
  //   tuning sweep. The training schedule is longer than the sweep and saves
  //   the minimum-validation checkpoint, so extra epochs cannot overwrite the
  //   best model.
  "miscellaneous_settings": {
    "random_seed": 42,
    "num_workers": 16,
    "detect_anomaly": false,
    "shard_size": 10000,
    "hdf5_read_chunk_size": 8192,
    "device_backend": "cuda",
    "torch_compile": false,
    "compile_mode": "default",
    "execution_mode": "train",
    "rebuild_processed_data": false,
    "dataset_loading_mode": "auto",
    "dataset_max_cached_shards": 200,
    "dataset_large_shard_mmap_bytes": 52428800,
    "dataset_ram_safety_fraction": 0.8,
    "dataset_copy_mmap_slices": true
  },
  "data_paths_config": {
    "hdf5_dataset_filename": [
      "picaso_results_5M.h5"
    ],
    "dataset_splits_filename": "dataset_splits.json",
    "dataset_split_fractions": {
      "train": 0.7,
      "validation": 0.15,
      "test": 0.15
    }
  },
  "data_specification": {
    "input_variables": [
      "pressure_bar",
      "temperature_k"
    ],
    "global_variables": [
      "orbital_distance_m"
    ],
    "target_variables": [
      "net_thermal_flux",
      "net_reflected_flux"
    ],
    "strictly_positive_variables": [
      "pressure_bar",
      "temperature_k",
      "orbital_distance_m"
    ],
    "variable_units": {
      "pressure_bar": "bar",
      "temperature_k": "K",
      "orbital_distance_m": "m",
      "net_thermal_flux": "erg cm^-2 s^-1",
      "net_reflected_flux": "erg cm^-2 s^-1"
    },
    "padding_value": -9999.0
  },
  "normalization": {
    "key_methods": {
      "pressure_bar": "log-min-max",
      "temperature_k": "standard",
      "orbital_distance_m": "log-standard",
      "net_thermal_flux": "symlog",
      "net_reflected_flux": "symlog"
    },
    "epsilon": 1e-9,
    "padding_comparison_epsilon": 1e-6,
    "normalized_value_clamp": 50.0,
    "log_min_max_clamp_min": 0.0,
    "log_min_max_clamp_max": 1.0,
    "symlog_min_threshold_multiplier": 100.0,
    "stats_max_block_bytes": 536870912,
    "stats_max_span_multiplier": 16,
    "stats_chunk_size": 4096,
    "quantile_max_values_in_memory": 100000,
    "symlog_percentile": 0.01
  },
  "precision": {
    "input_dtype": "float32",
    "stats_accumulation_dtype": "float32",
    "model_dtype": "float32",
    "forward_dtype": "float32",
    "loss_dtype": "float32",
    "optimizer_state_dtype": "float32",
    "amp_autocast_dtype": "bfloat16",
    "float32_matmul_precision": "high"
  },
  "model_hyperparameters": {
    "model_type": "transformer",
    "d_model": 256,
    "dropout": 0.0,
    "film_clamp": 1000.0,
    "max_sequence_length": 75,
    "output_head_divisor": 1,
    "output_head_dropout_factor": 0.0,
    "head_activation": "gelu",
    "transformer": {
      "nhead": 4,
      "num_layers": 5,
      "dim_feedforward": 1536,
      "attention_dropout": 0.0,
      "use_qk_norm": true,
      "qkv_bias": true,
      "ffn_type": "gelu"
    },
    "lstm": {
      "num_layers": 2,
      "bidirectional": true
    }
  },
  "training_hyperparameters": {
    "epochs": 300,
    "batch_size": 256,
    "learning_rate": 0.0001,
    "weight_decay": 1e-5,
    "optimizer": "adamw",
    "adam_beta1": 0.9,
    "adam_beta2": 0.95,
    "gradient_clip_val": 2.0,
    "scheduler_type": "cosine",
    "min_lr": 1e-08,
    "warmup_epochs": 2,
    "warmup_start_factor": 0.1,
    "warmup_unit": "step",
    "plateau_patience": 10,
    "plateau_factor": 0.5,
    "plateau_threshold": 1e-05,
    "plateau_threshold_mode": "abs",
    "early_stopping_patience": 60,
    "min_delta": 1e-10,
    "use_amp": true,
    "ema_decay": 0.999,
    "dataset_fraction_to_use": 0.40
  },
  "loss": {
    "type": "signed_log_adaptive",
    "lambda_z": 1.0,
    "lambda_phys": 0.0,
    "fractional_epsilon": 1.0,
    "p_norm": 1,
    "weight_mode": "uniform",
    "weight_power": 0.0,
    "w_min": 1.0,
    "w_max": 1.0
  },
  "output_paths_config": {
    "fixed_model_foldername": "transformer_win_candidate"
  }
}
