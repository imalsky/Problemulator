    "    return values\n",
    "\n",
    "def denormalize_batch(config, meta, inputs_norm, masks, targets_norm, target_masks):\n",
    "    ds = config[\"data_specification\"]\n",
    "    in_v, glob_v, tgt_v = ds[\"input_variables\"], ds[\"global_variables\"], ds[\"target_variables\"]\n",
