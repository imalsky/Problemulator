    "            if bsel.sum() < 3:\n",
    "                continue\n",
    "\n",
    "            vals = signed_pct[bsel]\n",
    "\n",
    "            centers.append(float(np.sqrt(bins[i] * bins[i + 1])))\n",
    "            means.append(float(np.mean(vals)))\n",
    "            q25.append(float(np.percentile(vals, 25)))\n",
